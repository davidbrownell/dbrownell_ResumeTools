# SimpleSchema for JSON Resume (https://jsonresume.org) Schema (https://jsonresume.org/schema/).
# This is useful so that data can be written in YAML (which supports comments and other conveniences),
# converted to JSON, and then imported by JSON Resume.

# An ISO 8601 date whose month and day are optional (e.g. 2014, 2014-06, 2014-06-29).
(Date string)

<resume_data>:
    <basics>:
        <name string>
        <label string ?>
        <image uri ?>
        <email string ?>
        <phone string ?>
        <url uri ?>
        <summary string ?>

        <location ?>:
            <address string>
            <postalCode string>
            <city string>
            <countryCode string ?> # ISO-3166-1 ALPHA-2
            <region string ?> # state or province

        <profiles *>:
            <network string>
            <username string>
            <url uri>

    <work *>:
        <name string> # the company
        <location string ?> # e.g. Menlo Park, CA
        <description string ?> # e.g. Social Media Company
        <position string>
        <url uri ?>
        <startDate Date>
        <endDate Date ?>
        <summary string>
        <highlights string *>

    <volunteer *>:
        <organization string>
        <position string>
        <url uri ?>
        <startDate Date>
        <endDate Date ?>
        <summary string>
        <highlights string *>

    <education *>:
        <institution string>
        <url uri ?>
        <area string>
        <studyType string>
        <startDate Date ?>
        <endDate Date ?>
        <score string ?> # grade point average
        <courses string *>

    <awards *>:
        <title string>
        <date_ Date name="date">
        <awarder string>
        <summary string>

    <certificates *>:
        <name string>
        <date_ Date name="date" ?>
        <url uri ?>
        <issuer string>

    <publications *>:
        <name string>
        <publisher string>
        <releaseDate Date>
        <url uri ?>
        <summary string>

    <skills *>:
        <name string>
        <level string ?> # e.g. Master
        <keywords string *>

    <languages *>:
        <language string>
        <fluency string>

    <interests *>:
        <name string>
        <keywords string *>

    <references *>:
        <name string>
        <reference string ?>

    <projects *>:
        <name string>
        <description string>
        <highlights string *>
        <keywords string *>
        <startDate Date ?>
        <endDate Date ?>
        <url uri ?>
        <roles string *>
        <entity string ?> # e.g. greenpeace
        <type_ string name="type" ?> # e.g. volunteering, presentation, talk, application, conference

    <meta ?>:
        <canonical uri ?>
        <version string ?> # semver, e.g. v1.0.0
        <lastModified string ?> # ISO 8601, e.g. 2014-06-29T09:00:00
